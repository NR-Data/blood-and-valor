                "name": "Weapons",
                "$text": "1 - 57mm gun (Fixed Forward 180)\n2 - HMG (Fixed Right Side 180)\n2 - HMG (Fixed Left Side 180)\n2 - HMG (Fixed Rear Side 180)",
                "typeId": "a985-d4b6-0f2b-b8a7"
