        ],
        "rules": [
          {
            "name": "Heavy Gun (Vehicle)",
            "id": "7b20-775c-e3f9-ab9b",
            "description": "If this weapon rolls a success on its Shoot action, roll 5 or more D10 with a target number of 7. The defender then rolls 1D10 for each success with a target number of 9 instead of a normal save (cover bonuses are not applied for Saves against Heavy Gun damage). Defender removes 1 model for each failed save. Resolve test is performed as normal.",
            "hidden": false,
            "page": 97,
            "publicationId": "e568-bb77-58cb-d3b5"
          },
          {
            "name": "Heavy Machine Gun (Vehicle)",
            "id": "612e-6897-b60b-fb02",
            "description": "(+1) to the target number of save tests taken as a result of being hit by this weapon.",
